{
  "manifest_version": 3,
  "name": "Toystaller: WhatsApp Edition",
  "version": "6.0",
  "description": "Specialized HD media downloader for WhatsApp Web — Chat images & videos, Status updates, and Media Lightbox.",
  "icons": {
    "16": "Toystaller_logo.png",
    "48": "Toystaller_logo.png",
    "128": "Toystaller_logo.png"
  },
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*",
    "*://*.whatsapp.net/*",
    "*://*.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background_script.js"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["page_interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": [
        "platforms/whatsapp.js",
        "overlay_manager.js",
        "core/content_core.js",
        "content_script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page_interceptor.js",
        "platforms/whatsapp.js",
        "player.html",
        "player.js",
        "Toystaller_logo.png"
      ],
      "matches": ["*://web.whatsapp.com/*"]
    }
  ],
  "action": {
    "default_title": "Toystaller: WhatsApp Edition",
    "default_icon": "Toystaller_logo.png",
    "default_popup": "popup.html"
  }
}
