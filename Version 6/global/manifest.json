{
  "manifest_version": 3,
  "name": "Toystaller Global",
  "version": "6.0",
  "description": "Download and save high-quality images and videos from Instagram, LinkedIn, Facebook, WhatsApp, and more with in-browser anti-redirect HTML5 player.",
  "incognito": "split",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.linkedin.com/*",
        "*://*.facebook.com/*",
        "*://web.whatsapp.com/*"
      ],
      "js": [
        "platforms/instagram.js",
        "platforms/linkedin.js",
        "platforms/facebook.js",
        "platforms/whatsapp.js",
        "core/overlay_manager.js",
        "core/content_core.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "platforms/instagram.js",
        "platforms/linkedin.js",
        "platforms/facebook.js",
        "platforms/whatsapp.js",
        "core/interceptor_core.js",
        "player.html",
        "player.js",
        "hls.min.js",
        "icon.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Toystaller Global",
    "default_icon": "icon.png"
  }
}
