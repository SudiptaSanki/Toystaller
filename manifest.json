{
  "manifest_version": 3,
  "name": "Toystaller",
  "version": "6.0",
  "description": "All-in-one smart media downloader and in-browser anti-redirect HTML5 player for Instagram, Facebook, LinkedIn, WhatsApp, and more.",
  "incognito": "split",
  "icons": {
    "16": "Toystaller_logo.png",
    "48": "Toystaller_logo.png",
    "128": "Toystaller_logo.png"
  },
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background_script.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://facebook.com/*",
        "*://*.messenger.com/*",
        "*://messenger.com/*"
      ],
      "js": [
        "specialized/facebook/platforms/facebook.js",
        "specialized/facebook/overlay_manager.js",
        "specialized/facebook/content_script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://linkedin.com/*"
      ],
      "js": [
        "specialized/linkedin/platforms/linkedin.js",
        "specialized/linkedin/overlay_manager.js",
        "specialized/linkedin/content_script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": [
        "specialized/instagram/platforms/instagram.js",
        "specialized/instagram/overlay_manager.js",
        "specialized/instagram/content_script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://web.whatsapp.com/*",
        "*://*.whatsapp.com/*",
        "*://whatsapp.com/*"
      ],
      "js": [
        "specialized/whatsapp/platforms/whatsapp.js",
        "specialized/whatsapp/core/overlay_manager.js",
        "specialized/whatsapp/core/content_core.js",
        "specialized/whatsapp/content_script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.facebook.com/*",
        "*://facebook.com/*",
        "*://*.messenger.com/*",
        "*://messenger.com/*",
        "*://*.linkedin.com/*",
        "*://linkedin.com/*",
        "*://*.instagram.com/*",
        "*://instagram.com/*",
        "*://*.whatsapp.com/*",
        "*://whatsapp.com/*",
        "*://web.whatsapp.com/*"
      ],
      "js": [
        "platforms/generic.js",
        "overlay_manager.js",
        "content_script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "specialized/facebook/player.html",
        "specialized/facebook/player.js",
        "specialized/linkedin/player.html",
        "specialized/linkedin/player.js",
        "specialized/linkedin/hls.min.js",
        "specialized/linkedin/platforms/linkedin.js",
        "specialized/linkedin/page_interceptor.js",
        "specialized/facebook/platforms/facebook.js",
        "specialized/facebook/page_interceptor.js",
        "specialized/instagram/platforms/instagram.js",
        "specialized/instagram/page_interceptor.js",
        "specialized/whatsapp/platforms/whatsapp.js",
        "specialized/whatsapp/page_interceptor.js",
        "page_interceptor.js",
        "platforms/generic.js",
        "player.html",
        "player.js",
        "hls.min.js",
        "Toystaller_logo.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Toystaller Downloader",
    "default_icon": "Toystaller_logo.png"
  }
}
